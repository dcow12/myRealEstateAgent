# Copy to .env.local (gitignored). Set one key; with none, agents answer in rules-only mode.
# Gemini (free key from https://aistudio.google.com/apikey). Picked first when present.
GEMINI_API_KEY=
# Optional: try this model first. Default order: gemini-flash-lite-latest, gemini-3.5-flash, gemini-flash-latest, gemini-3.5-flash-lite
# GEMINI_MODEL=

# Claude (optional alternative)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Force a provider: gemini | claude | off
# PLOTTWIST_LLM=
