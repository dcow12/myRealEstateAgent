      "html": "<button class=\"ds-btn\">City view</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border:1px solid var(--border-strong);border-radius:var(--r);background:var(--surface);color:var(--text);font:500 13px/1 var(--font);transition:background-color 120ms var(--ease),border-color 120ms var(--ease),color 120ms var(--ease);cursor:pointer}.ds-btn:hover{background:var(--surface-2)}.ds-btn:active{background:var(--surface-3)}.ds-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Cobalt action; used for Send.",
      "html": "<button class=\"ds-btn-primary\">Send</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;height:28px;padding:0 10px;border:1px solid var(--accent);border-radius:var(--r);background:var(--accent);color:var(--accent-text);font:500 13px/1 var(--font);transition:background-color 120ms var(--ease),border-color 120ms var(--ease);cursor:pointer}.ds-btn-primary:hover{background:var(--accent-hover);border-color:var(--accent-hover)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet toolbar action; pressed toggles turn cobalt.",
      "html": "<button class=\"ds-btn-ghost\">Reset</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;height:28px;padding:0 10px;border:1px solid transparent;border-radius:var(--r);background:transparent;color:var(--text-2);font:500 13px/1 var(--font);transition:background-color 120ms var(--ease),color 120ms var(--ease);cursor:pointer}.ds-btn-ghost:hover{background:var(--surface-2);color:var(--text)}.ds-btn-ghost[aria-pressed=true]{color:var(--accent);background:var(--accent-soft)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
