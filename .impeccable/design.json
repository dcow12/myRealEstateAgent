      "css": ".ds-seg{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;padding:2px;border:1px solid var(--border);border-radius:var(--r);background:var(--surface-2)}.ds-seg button{height:24px;border:0;border-radius:var(--r-sm);background:transparent;color:var(--text-2);font:500 12px var(--font);font-variant-numeric:tabular-nums;cursor:pointer;transition:background-color 120ms var(--ease),color 120ms var(--ease)}.ds-seg button:hover{color:var(--text)}.ds-seg button[aria-pressed=true]{background:var(--surface);color:var(--text);box-shadow:var(--elev-1)}.ds-seg button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
